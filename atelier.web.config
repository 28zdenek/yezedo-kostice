<?xml version="1.0" encoding="UTF-8"?>
<!-- Ostrý web www.yezedokostice.cz (IIS) – verze od Atelieru Dohnalovi (web v atelier/, skládá build_prod.py).
     Vychází z web.config ověřeného na serveru 13. 10. 2026. Oproti němu (19. 11. 2026):
     - zámek heslem jako dřív: pravidlo "heslo" pustí jen s cookie z login.aspx (token); hodnoty @@LOGIN_…@@
       dosazuje build_prod.py z .site-password (mimo git). Vypnout = LOCKED = False v build_prod.py,
     - typ .ttf (písma ateliéru), remove + mimeMap, aby nevznikl duplicitní záznam,
     - style-src 'unsafe-inline' (atelier má v areal.html pozice bodů mapky v atributu style),
     - trvalá přesměrování starých adres /development/, /services/, /biq/, /dokumenty/.
     Chybná nebo hostingem zakázaná sekce shodí celý web chybou 500 – po nahrání hned zkontrolovat. -->
<configuration>
    <appSettings>
        <add key="LoginSalt" value="@@LOGIN_SALT@@" />
        <add key="LoginHash" value="@@LOGIN_HASH@@" />
        <add key="LoginToken" value="@@LOGIN_TOKEN@@" />
    </appSettings>
    <system.webServer>
        <directoryBrowse enabled="false" />
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".ttf" />
            <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
        </staticContent>
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" path="404.html" responseMode="File" />
        </httpErrors>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
                <add name="X-Frame-Options" value="DENY" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
            </customHeaders>
        </httpProtocol>
        <rewrite>
            <rules>
                <rule name="https-www" stopProcessing="true">
                    <match url="^(?!\.well-known/)(.*)$" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{HTTPS}" pattern="off" />
                        <add input="{HTTP_HOST}" pattern="^yezedokostice\.cz$" />
                    </conditions>
                    <action type="Redirect" url="https://www.yezedokostice.cz/{R:1}" redirectType="Permanent" />
                </rule>
                <!--HESLO-->
                <rule name="heslo" stopProcessing="true">
                    <match url="^(?!login\.aspx$|robots\.txt$|favicon\.ico$|assets/fonts/|assets/images/mark\.png$|\.well-known/)" />
                    <conditions>
                        <add input="{HTTP_COOKIE}" pattern="(?:^|;\s*)yezedo=@@LOGIN_TOKEN@@(?:;|$)" negate="true" />
                    </conditions>
                    <action type="Redirect" url="/login.aspx?ReturnUrl={UrlEncode:{REQUEST_URI}}" appendQueryString="false" redirectType="Found" />
                </rule>
                <!--/HESLO-->
                <rule name="stare-development" stopProcessing="true">
                    <match url="^development/?(index\.html)?$" />
                    <action type="Redirect" url="/development.html" redirectType="Permanent" />
                </rule>
                <rule name="stare-services" stopProcessing="true">
                    <match url="^services/?(index\.html)?$" />
                    <action type="Redirect" url="/services.html" redirectType="Permanent" />
                </rule>
                <rule name="stare-biq" stopProcessing="true">
                    <match url="^biq/?(index\.html)?$" />
                    <action type="Redirect" url="/biq.html" redirectType="Permanent" />
                </rule>
                <rule name="stare-dokumenty" stopProcessing="true">
                    <match url="^dokumenty/?(index\.html)?$" />
                    <action type="Redirect" url="/nabidka-hal.html#dokumenty" redirectType="Permanent" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
    <location path="assets">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
